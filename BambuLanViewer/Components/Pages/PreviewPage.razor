@page "/previewpage"
@implements IAsyncDisposable
@inject NavigationManager Navigator

<div class="preview-container">
    <img src="@ImageUrl" @onclick="NavigateBack" />
</div>

@code {
    private string ImageUrl => $"/preview?t={timestamp}";

    private long timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    private readonly CancellationTokenSource cancellationToken = new();

    protected override void OnInitialized()
    {
        _ = RefreshImageAsync(cancellationToken.Token);
    }

    private async Task RefreshImageAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

                await InvokeAsync(StateHasChanged);

                await Task.Delay(3000, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the component is disposed.
        }
    }

    private void NavigateBack()
    {
        Navigator.NavigateTo("/", true);
    }

    public async ValueTask DisposeAsync()
    {
        await cancellationToken.CancelAsync();
        cancellationToken.Dispose();
    }
}