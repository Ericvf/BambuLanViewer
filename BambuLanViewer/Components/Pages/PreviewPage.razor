@page "/previewpage"
@inject NavigationManager Navigator

<div class="preview-container">
    <img src="/preview" @onclick="NavigateBack" />
</div>

@code {
    private async Task NavigateBack()
    {
        Navigator.NavigateTo("/", true);
    }
}

<style>
    .preview-container {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .preview-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            cursor: pointer;
        }
</style>
