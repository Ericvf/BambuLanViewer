@page "/"
@using BambuLanViewer.Services
@using MQTTnet

@inject IBambuMttqClient BambuMttqClient
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>BambuLanViewer</PageTitle>

@if (BambuMttqClient.IsConnected && PrinterData != null)
{
    <div class="progress-layout" @onclick="ShowDialog">
        <div class="progress-wrapper">
            <div class="radial-progress" style="--value: @PrinterData.PrintPercentage;" role="progressbar" aria-valuenow="@PrinterData.PrintPercentage" aria-valuemin="0" aria-valuemax="100">
            </div>

            <div class="position-box top">@PrinterData.PrintPercentage%</div>
            <div class="position-box left">@PrinterData.NozzleTemp °C</div>
            <div class="position-box center">Layer: @PrinterData.PrintLayer / @PrinterData.TotalLayers</div>
            <div class="position-box right">@PrinterData.BedTemp °C</div>
            <div class="position-box bottom">⏱️@PrinterData.RemainingMinutes min</div>
            <div class="position-box title">@PrinterData.PrintObjectName </div>
            <div class="position-box status">@PrinterData.PrintStatus</div>
        </div>
    </div>

    <dialog id="my-dialog" @onclick="CloseDialog">
        <img src="@imageUrl" />
    </dialog>
}
else if (!BambuMttqClient.IsConnected)
{
    <div class="loader-layout">
        <div><span class="loader"></span></div>
        <div>@message</div>
    </div>
}

@code {
    private PrinterDataModel? PrinterData { get; set; }
    private string message = "Waiting for printer data...";

    private string? baseUrl = null;
    private string imageUrl = "";

    protected override async Task OnInitializedAsync()
    {
        baseUrl = Configuration["BambuMttqClient:CameraUrl"];

        BambuMttqClient.Connected += OnMqttConnected;
        BambuMttqClient.Disconnected += OnMqttDisconnected;
        BambuMttqClient.MessageReceived += OnMessageReceived;

    }

    private async Task ShowDialog()
    {
        if (baseUrl != null)
        {
            imageUrl = $"/preview?t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            await JS.InvokeVoidAsync(
                "dialog.open",
                "my-dialog");
        }
    }

    private async Task CloseDialog()
    {
        await JS.InvokeVoidAsync(
            "dialog.close",
            "my-dialog");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("scaleProgress");

            while (!BambuMttqClient.IsConnected)
            {
                try
                {
                    await BambuMttqClient.ConnectAsync();
                }
                catch (Exception ex)
                {
                    message = ex.Message;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(TimeSpan.FromSeconds(5));
                }
            }
        }
    }


    private void OnMqttConnected(object? sender, MqttClientConnectedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnMqttDisconnected(object? sender, MqttClientDisconnectedEventArgs e)
    {
        PrinterData = null;
        InvokeAsync(StateHasChanged);
    }

    private async void OnMessageReceived(object? sender, Services.PrinterDataModel e)
    {
        try
        {
            PrinterData = e;
            await InvokeAsync(StateHasChanged);
            await InvokeAsync(() => JS.InvokeVoidAsync("scaleProgress"));
        }
        catch (Exception ex)
        {
            message = $"{ex.Message}";
        }
    }

    public void Dispose()
    {
        BambuMttqClient.Connected -= OnMqttConnected;
        BambuMttqClient.Disconnected -= OnMqttDisconnected;
        BambuMttqClient.MessageReceived -= OnMessageReceived;
    }
}