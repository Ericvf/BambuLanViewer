@code {
    private PrinterDataModel? PrinterData { get; set; }
    private SynchronizationContext? _syncContext;

    protected override async Task OnInitializedAsync()
    {
        // Capture the UI synchronization context so we can marshal calls back to it
        _syncContext = SynchronizationContext.Current;

        // Subscribe to MQTT events
        BambuMttqClient.Connected += OnMqttConnected;
        BambuMttqClient.Disconnected += OnMqttDisconnected;
        BambuMttqClient.MessageReceived += OnMessageReceived;

        if (!BambuMttqClient.IsConnected)
        {
            try
            {
                await BambuMttqClient.ConnectAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Connection error: {ex.Message}");
            }
        }
    }

    private void OnMqttConnected(object? sender, MqttClientConnectedEventArgs e)
    {
        Console.WriteLine("Connected to MQTT broker");

        // Marshal back to UI thread
        if (_syncContext != null)
        {
            _syncContext.Post(_ => StateHasChanged(), null);
        }
        else
        {
            StateHasChanged();
        }
    }

    private void OnMqttDisconnected(object? sender, MqttClientDisconnectedEventArgs e)
    {
        Console.WriteLine("Disconnected from MQTT broker");
        PrinterData = null;

        // Marshal back to UI thread
        if (_syncContext != null)
        {
            _syncContext.Post(_ => StateHasChanged(), null);
        }
        else
        {
            StateHasChanged();
        }
    }

    private void OnMessageReceived(object? sender, Services.PrinterDataModel e)
    {
        try
        {
            Console.WriteLine($"Printer data updated: {e.PrintPercentage}%");
            PrinterData = e;
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing message: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Unsubscribe from events to prevent memory leaks
        BambuMttqClient.Connected -= OnMqttConnected;
        BambuMttqClient.Disconnected -= OnMqttDisconnected;
        BambuMttqClient.MessageReceived -= OnMessageReceived;
    }
}