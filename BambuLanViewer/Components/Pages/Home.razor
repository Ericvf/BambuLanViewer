@page "/"

@using BambuLanViewer.Services
@using MQTTnet

@implements IAsyncDisposable

@inject ILogger<Home> Logger
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IBambuMqttClient BambuMqttClient
@inject BambuCircuitHandler CircuitHandler

<PageTitle>BambuLanViewer</PageTitle>

@if (BambuMqttClient.IsConnected && PrinterData != null)
{
    <div class="progress-layout" @onclick="ShowDialog">
        <div class="progress-wrapper">
            <div class="radial-progress" style="--value: @PrinterData.PrintPercentage;" role="progressbar" aria-valuenow="@PrinterData.PrintPercentage" aria-valuemin="0" aria-valuemax="100">
            </div>

            <div class="position-box top">@PrinterData.PrintPercentage%</div>
            <div class="position-box left">@PrinterData.NozzleTemp °C</div>
            <div class="position-box center">Layer: @PrinterData.PrintLayer / @PrinterData.TotalLayers</div>
            <div class="position-box right">@PrinterData.BedTemp °C</div>
            <div class="position-box bottom">⏱️@PrinterData.RemainingMinutes min</div>
            <div class="position-box title">@PrinterData.PrintObjectName </div>
            <div class="position-box status">@PrinterData.PrintStatus</div>
        </div>
    </div>
}
else if (!BambuMqttClient.IsConnected)
{
    <div class="loader-layout">
        <div><span class="loader"></span></div>
        <div>@message</div>
    </div>
}

@code {
    private PrinterDataModel? PrinterData { get; set; }
    private string message = "Waiting for printer data...";

    private string? baseUrl = null;

    protected override async Task OnInitializedAsync()
    {
        baseUrl = Configuration["BambuMqttClient:CameraUrl"];

        BambuMqttClient.Connected += OnMqttConnected;
        BambuMqttClient.Disconnected += OnMqttDisconnected;
        BambuMqttClient.MessageReceived += OnMessageReceived;
    }

    private async Task ShowDialog()
    {
        Navigation.NavigateTo("/previewpage", false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("scaleProgress");
            await CircuitHandler.StartViewingAsync();
        }
    }

    private async void OnMqttConnected(object? sender, MqttClientConnectedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnMqttDisconnected(object? sender, MqttClientDisconnectedEventArgs e)
    {
        PrinterData = null;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnMessageReceived(object? sender, Services.PrinterDataModel e)
    {
        try
        {
            PrinterData = e;
            await InvokeAsync(StateHasChanged);
            await InvokeAsync(() => JS.InvokeVoidAsync("scaleProgress"));
        }
        catch (Exception ex)
        {
            message = $"{ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        BambuMqttClient.Connected -= OnMqttConnected;
        BambuMqttClient.Disconnected -= OnMqttDisconnected;
        BambuMqttClient.MessageReceived -= OnMessageReceived;
        
        CircuitHandler.StopViewing();
    }
}